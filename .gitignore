# 1.	Ignore everything
*

# 2.	Un-ignore directories so git can traverse them.
#		This is necessary so git can find the files to un-ignore below.
!*/

# 3.	Un-ignore the allowed file extensions
!*.cs
!*.xaml
!*.in
!*.out
!*.ans
!*.md
!*.txt
!*.config

# 4.	Ignore VS related directories
/Solid1/obj
/Solid1/bin
/Solid1/Properties

/Solid2/obj
/Solid2/bin
/Solid2/Properties

/Solid_3/obj
/Solid_3/bin
/Solid_3/Properties

/Solid_4/obj
/Solid_4/bin
/Solid_4/Properties

# 5.	Un-ignore this file itself so it can be committed
!/.gitignore

